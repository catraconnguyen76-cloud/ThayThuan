@model QUANLYBANHANG_MVC.tbDANHMUC
@{
    ViewBag.Title = "Sửa danh mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin_card" style="max-width:600px;">
    <h2>✏ Sửa Danh Mục: @Model.TENDANHMUC</h2>

    @if (!string.IsNullOrEmpty(ViewBag.ThongBao as string))
    {
        <div class="alert alert-warning">⚠ @ViewBag.ThongBao</div>
    }

    @using (Html.BeginForm("SuaDoi", "AdminDanhMuc", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="MADANHMUC" value="@Model.MADANHMUC" />

        <div class="form_row">
            <label>Mã danh mục</label>
            <input type="text" value="@Model.MADANHMUC" disabled style="background:#f0f0f0; color:#888;" />
        </div>

        <div class="form_row">
            <label>Tên danh mục <span style="color:red;">*</span></label>
            <input type="text" name="TENDANHMUC" id="TENDANHMUC" value="@Model.TENDANHMUC" placeholder="Nhập tên danh mục..." />
        </div>

        <div class="form_row">
            <label>Mô tả</label>
            <textarea name="MOTA" id="MOTA" rows="3" placeholder="Mô tả về danh mục...">@Model.MOTA</textarea>
        </div>

        <div style="margin-top:20px;">
            <button type="submit" class="btn btn-primary">💾 Cập nhật</button>
            &nbsp;
            <a href="@Url.Action("Index", "AdminDanhMuc")" class="btn btn-secondary">↩ Quay lại</a>
        </div>
    }
</div>
